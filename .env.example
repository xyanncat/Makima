# =========================================================================
# Makima Chatbot Configuration
# Rename this file to .env and fill in the values.
# =========================================================================

# -------------------------------------------------------------------------
# Host settings
# -------------------------------------------------------------------------
PORT=3000
# Used for Render self-ping. Put your public Render Service URL here
# Example: https://makima-bot.onrender.com
RENDER_EXTERNAL_URL=

# -------------------------------------------------------------------------
# AI (Groq API)
# -------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.1-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# -------------------------------------------------------------------------
# Twitch Integration (Optional)
# -------------------------------------------------------------------------
# Name of the Twitch channel chat to join
TWITCH_CHANNEL=your_streamer_twitch_username
# Account username of the bot (can be the same as channel)
TWITCH_BOT_USERNAME=
# Twitch OAuth token for writing messages (retrieve from https://twitchapps.com/tmi/)
# Must start with "oauth:"
TWITCH_OAUTH_TOKEN=

# -------------------------------------------------------------------------
# YouTube Integration (Optional)
# -------------------------------------------------------------------------
# Channel ID of the YouTube streamer (resolves live chats automatically)
# Find it by clicking channel -> About -> Share -> Copy Channel ID
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# Google OAuth Client Credentials (to send messages)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Refresh token generated via `npm run get-yt-token`
YOUTUBE_REFRESH_TOKEN=

# -------------------------------------------------------------------------
# Kick Integration (Optional)
# -------------------------------------------------------------------------
# Channel Name of the Kick streamer (e.g. from kick.com/streamername)
KICK_CHANNEL_NAME=streamername
# Numeric Chatroom ID (optional - helps bypass Cloudflare lookup checks)
KICK_CHATROOM_ID=
# Bot authorization token or cookies (to send messages as bot)
# Prefix with 'Bearer ' if passing a developer token
KICK_BOT_TOKEN=
