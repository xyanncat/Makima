# =========================================================================
# Makima Chatbot Configuration
# Rename this file to .env and fill in the values.
# =========================================================================

# -------------------------------------------------------------------------
# Host settings
# -------------------------------------------------------------------------
PORT=3000
# Used for Render self-ping. Put your public Render Service URL here
# Example: https://makima-bot.onrender.com
RENDER_EXTERNAL_URL=

# -------------------------------------------------------------------------
# AI (Groq API)
# -------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.1-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# -------------------------------------------------------------------------
# YouTube Integration (Optional)
# -------------------------------------------------------------------------
# Channel ID of the YouTube streamer (resolves live chats automatically)
# Find it by clicking channel -> About -> Share -> Copy Channel ID
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# Google OAuth Client Credentials (to send messages)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Refresh token generated via `npm run get-yt-token`
YOUTUBE_REFRESH_TOKEN=

# -------------------------------------------------------------------------
# Persistent State Layer (Optional - enables cross-restart durability)
# -------------------------------------------------------------------------
# Upstash Redis REST URL (deduplication + per-user rate limiting).
# Leave blank to use an in-memory store (state lost on restart).
REDIS_URL=
# PostgreSQL / Supabase connection string (OAuth tokens + command logs).
# Leave blank to store tokens in-memory only.
DATABASE_URL=

# -------------------------------------------------------------------------
# Dashboard Basic Auth (lock the web dashboard)
# -------------------------------------------------------------------------
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# -------------------------------------------------------------------------
# Outbound Queue Throttling (ms between messages / max buffered)
# -------------------------------------------------------------------------
YOUTUBE_QUEUE_MS=5000
QUEUE_MAX_BUFFER=10

# Seconds before token expiry at which an auto-refresh is triggered
TOKEN_REFRESH_BUFFER_SEC=300
